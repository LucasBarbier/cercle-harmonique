{
  "name": "cercle-harmonique",
  "version": "0.1.0",
  "private": true,
  "description": "Analyse harmonique de grilles d'accords et générateur d'études (web + mobile Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite www --host",
    "test": "node --test tests/*.test.mjs",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "android": "cap sync android && cap run android",
    "android:open": "cap open android",
    "ios": "cap sync ios && cap run ios",
    "android:live": "cap run android --live-reload --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^6.0.0"
  }
}
